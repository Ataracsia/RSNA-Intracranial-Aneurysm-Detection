+    "# count execution time for one epoch\n",
+    "def count_time(start:float) -> float:\n",
+    "    \n",
+    "    elapsed_time = time.time() - start\n",
+    "    elapsed_time /= 60\n",
+    "    \n",
+    "    return elapsed_time\n"
+   ]
+  },
+  {
+   "cell_type": "code",
