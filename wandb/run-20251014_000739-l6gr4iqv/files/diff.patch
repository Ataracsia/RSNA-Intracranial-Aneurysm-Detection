+    "#     model.load_state_dict(save_dir + '/model.pth')\n",
+    "#     optimizer.load_state_dict(save_dir + '/optimizer.pth')\n",
+    "#     scheduler.load_state_dict(save_dir + '/scheduler.pth')\n",
